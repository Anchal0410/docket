# ── Broker: app ──────────────────────────────────────────────────────────────
NODE_ENV=development
# 4400, not 3000 — a handful of the other local projects already use 3000.
PORT=4400
SWAGGER_ENABLED=true

# ── Broker: database ─────────────────────────────────────────────────────────
# Port 5544, not 5432 — docker-compose.yml maps postgres there on the host to
# avoid clashing with other local Postgres containers (5432 and 5433 are both
# already taken on this machine).
DATABASE_URL=postgresql://docket:docket@localhost:5544/docket

# ── Broker: queue tuning (all optional, shown with defaults) ──────────────────
QUEUE_LEASE_SECONDS=30
QUEUE_CLAIM_MAX_BATCH=10
QUEUE_BACKOFF_BASE_SECONDS=2
QUEUE_BACKOFF_MAX_SECONDS=3600
QUEUE_DEAD_WORKER_THRESHOLD_SECONDS=15
QUEUE_RECOVERY_INTERVAL_MS=5000
QUEUE_PROMOTION_INTERVAL_MS=1000
# Fleet-wide cap on simultaneous PROCESSING jobs, per type. Types not listed
# are unrestricted.
QUEUE_TYPE_CONCURRENCY_LIMITS={}

# Applies to producer/operator-facing endpoints only (submit, get,
# dead-letter browse/retry) -- worker endpoints (claim/ack/fail/renew/
# register/heartbeat/deregister) are exempt, since the fleet polls them
# continuously by design.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

# ── Worker (pnpm start:worker) ───────────────────────────────────────────────
# WORKER_ID defaults to worker-<hostname>. Also accepts --id= --capabilities=
# --concurrency= --broker= CLI flags.
WORKER_CAPABILITIES=send_email
WORKER_CONCURRENCY=1
BROKER_URL=http://localhost:4400
# Must be shorter than QUEUE_LEASE_SECONDS.
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_LEASE_RENEW_MS=10000
