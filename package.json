{
    "name": "docket",
    "imports": {
        "#db": {
            "types": "./generated/prisma-client/index.d.ts",
            "default": "./generated/prisma-client/index.js"
        },
        "#db/*": {
            "types": "./generated/prisma-client/*.d.ts",
            "default": "./generated/prisma-client/*"
        },
        "#common/*": {
            "types": "./src/common/*",
            "default": "./dist/src/common/*"
        },
        "#config/*": {
            "types": "./src/config/*",
            "default": "./dist/src/config/*"
        },
        "#infra/*": {
            "types": "./src/infrastructure/*",
            "default": "./dist/src/infrastructure/*"
        },
        "#modules/*": {
            "types": "./src/modules/*",
            "default": "./dist/src/modules/*"
        }
    },
    "version": "0.0.1",
    "description": "Docket - a distributed job queue broker",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "packageManager": "pnpm@10.33.2",
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=10.0.0"
    },
    "scripts": {
        "build": "nest build && tsc -p worker/tsconfig.json",
        "build:worker": "tsc -p worker/tsconfig.json",
        "format": "prettier --write \"src/**/*.ts\" \"worker/**/*.ts\" \"*.{json,mjs,yaml,yml}\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"worker/**/*.ts\" \"*.{json,mjs,yaml,yml}\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/src/main.js",
        "start:worker": "tsx worker/src/main.ts",
        "start:worker:dev": "tsx watch worker/src/main.ts",
        "db:migrate": "prisma migrate dev",
        "db:migrate:prod": "prisma migrate deploy",
        "db:generate": "prisma generate",
        "db:studio": "prisma studio",
        "db:reset": "prisma migrate reset",
        "lint": "eslint \"{src,worker,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:int": "jest --config ./test/jest-integration.json --runInBand"
    },
    "dependencies": {
        "@fastify/compress": "^8.0.1",
        "@fastify/helmet": "^13.0.1",
        "@fastify/static": "^10.1.2",
        "@nestjs/common": "^11.0.1",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.0.1",
        "@nestjs/platform-fastify": "^11.0.1",
        "@nestjs/schedule": "^6.1.3",
        "@nestjs/swagger": "^11.4.2",
        "@nestjs/terminus": "^11.1.1",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "@prisma/client-runtime-utils": "7.8.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "fastify": "^5.2.0",
        "joi": "^18.2.1",
        "nestjs-pino": "^4.6.1",
        "pg": "^8.20.0",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "pino-pretty": "^13.1.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "uuidv7": "^1.2.1"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.18.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@testcontainers/postgresql": "^10.13.2",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.0.0",
        "@types/pg": "^8.20.0",
        "dotenv": "^17.4.2",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.2",
        "globals": "^17.0.0",
        "jest": "^30.0.0",
        "prettier": "^3.4.2",
        "prisma": "^7.8.0",
        "source-map-support": "^0.5.21",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.22.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0"
    },
    "jest": {
        "moduleFileExtensions": ["js", "json", "ts"],
        "rootDir": "src",
        "roots": ["<rootDir>", "<rootDir>/../worker"],
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "moduleNameMapper": {
            "^(\\.{1,2}/.*)\\.js$": "$1",
            "^#common/(.*)\\.js$": "<rootDir>/common/$1",
            "^#common/(.*)$": "<rootDir>/common/$1",
            "^#config/(.*)\\.js$": "<rootDir>/config/$1",
            "^#config/(.*)$": "<rootDir>/config/$1",
            "^#infra/(.*)\\.js$": "<rootDir>/infrastructure/$1",
            "^#infra/(.*)$": "<rootDir>/infrastructure/$1",
            "^#modules/(.*)\\.js$": "<rootDir>/modules/$1",
            "^#modules/(.*)$": "<rootDir>/modules/$1",
            "^#db$": "<rootDir>/../generated/prisma-client/index.js",
            "^#db/(.*)$": "<rootDir>/../generated/prisma-client/$1"
        },
        "collectCoverageFrom": ["**/*.(t|j)s"],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    },
    "prisma": {
        "schema": "prisma"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@parcel/watcher",
            "@prisma/engines",
            "@scarf/scarf",
            "esbuild",
            "prisma",
            "unrs-resolver"
        ]
    }
}
